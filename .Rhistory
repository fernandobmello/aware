)
incomplete_g1_imputed <- incomplete_g1_imputed %>%
mutate(
across(
all_of(numeric_cols),
as.numeric
)
)
# --------------------------------------------------
# 8) CHECAR NAs APÓS IMPUTAÇÃO
# --------------------------------------------------
check_na_g1 <- incomplete_g1_imputed %>%
summarise(
across(
all_of(cols_to_impute),
~ sum(is.na(.x))
)
)
print(check_na_g1)
# --------------------------------------------------
# 9) JUNTAR COMPLETOS + IMPUTADOS
# --------------------------------------------------
final_g1_with_imputed_incomplete <- bind_rows(
completed_g1,
incomplete_g1_imputed
)
students_by_teacher_g1 <- final_g1_with_imputed_incomplete %>%
mutate(
student_name = clean_text(`Nome do Aluno:`),
student_name_clean = clean_name(`Nome do Aluno:`),
Inputed = if_else(
is.na(Fim),
"Sim",
"Não"
)
) %>%
filter(
!is.na(teacher_clean),
!is.na(student_name)
) %>%
distinct(
teacher_clean,
student_name_clean,
.keep_all = TRUE
)
# ==================================================
# GRUPO 2 - DATA CLEANING & PROCESSING
# ==================================================
library(tidyverse)
library(readxl)
library(lubridate)
library(stringr)
library(stringi)
library(stringdist)
library(openxlsx)
# ==================================================
# HELPERS
# ==================================================
clean_text <- function(x) {
x %>%
as.character() %>%
stri_enc_toutf8() %>%
str_squish() %>%
na_if("") %>%
na_if("NA")
}
clean_name <- function(x) {
x %>%
clean_text() %>%
str_to_upper() %>%
stri_trans_general("Latin-ASCII") %>%
str_replace_all("[^A-Z ]", " ") %>%
str_squish() %>%
na_if("")
}
collapse_cols <- function(data, cols) {
cols <- cols[cols %in% names(data)]
if (length(cols) == 0) {
return(rep(NA_character_, nrow(data)))
}
data %>%
select(all_of(cols)) %>%
mutate(across(everything(), clean_text)) %>%
transmute(value = do.call(coalesce, across(everything()))) %>%
pull(value)
}
best_teacher_match <- function(open_name, candidates, max_dist = 0.22) {
open_clean <- clean_name(open_name)
cand_clean <- clean_name(candidates)
valid <- !is.na(cand_clean)
if (is.na(open_clean) || sum(valid) == 0) {
return(tibble(
teacher_fuzzy_match = NA_character_,
teacher_fuzzy_distance = NA_real_,
teacher_fuzzy_status = "no_open_or_no_candidates"
))
}
distances <- stringdist(open_clean, cand_clean[valid], method = "jw")
best_i <- which.min(distances)
tibble(
teacher_fuzzy_match = candidates[valid][best_i],
teacher_fuzzy_distance = distances[best_i],
teacher_fuzzy_status = if_else(distances[best_i] <= max_dist, "matched", "needs_review")
)
}
safe_file_name <- function(x) {
x %>%
stri_trans_general("Latin-ASCII") %>%
str_replace_all("[^A-Za-z0-9_ -]", "") %>%
str_squish() %>%
str_replace_all(" ", "_")
}
# ==================================================
# TEACHERS MASTER
# ==================================================
teachers <- read_excel(
"/Users/Mello/Dropbox/publications/bahia/final_df_with_groups.xlsx"
)
teachers_clean <- teachers %>%
mutate(
teacher_clean = clean_name(Nome),
teacher_matricula = as.character(Matrícula) %>%
str_replace_all("[^0-9]", "") %>%
str_squish()
) %>%
select(
teacher_clean,
teacher_name_original = Nome,
teacher_matricula,
grupo,
treatment,
block
) %>%
distinct(teacher_clean, .keep_all = TRUE)
# ==================================================
# COMMON COLS
# ==================================================
municipality_cols <- c(
"Municípios (NTE-26):",
"Município (NTEs 01 a 05):",
"Município (NTEs 6 a 10):",
"Município (NTEs 11 a 15):",
"Município (NTEs 16 a 20):",
"Município (NTEs 21 a 25 e 27):"
)
teacher_open_col <- "Caso não tenha encontrado o nome do seu professor na lista acima, escreva-o abaixo:"  # Define the open-ended teacher column name
# ==================================================
# LOAD DATA
# ==================================================
file_v1 <- "/Users/Mello/Dropbox/publications/bahia/baseline/data/v1.Grupo 2.Parcial Completa 26-4.xlsx"
file_v2 <- "/Users/Mello/Dropbox/publications/bahia/baseline/data/v7.Grupo 2. Parcial Completa 1-5.csv"
file_v3 <- "/Users/Mello/Dropbox/publications/bahia/baseline/data/v15.Grupo 2. Parcial Completa 11-5.csv"
file_v4 <- "/Users/Mello/Dropbox/publications/bahia/baseline/data/v28.Grupo 2. Parcial Completa 29-5.csv"
d  <- read_excel(file_v1)
d1 <- read_csv(file_v2)
d2 <- read_csv(file_v3)
d3 <- read_csv(file_v4)
# ==================================================
# CLEAN V1
# ==================================================
teacher_list_cols <- names(d) %>% str_subset("^Professor")
d_clean <- d %>%
mutate(
municipality = collapse_cols(cur_data(), municipality_cols),
school       = collapse_cols(cur_data(), names(d) %>% str_subset("Unidade")),
teacher_list = collapse_cols(cur_data(), teacher_list_cols),
teacher_open = clean_text(.data[[teacher_open_col]])  # Use the defined column
)
teacher_matches <- pmap_dfr(
d_clean %>% select(all_of(c(teacher_open_col, teacher_list_cols))),
function(...) {
row <- list(...)
best_teacher_match(row[[teacher_open_col]], unlist(row[teacher_list_cols]))
}
)
d_clean <- bind_cols(d_clean, teacher_matches) %>%
mutate(
teacher = coalesce(teacher_fuzzy_match, teacher_list, teacher_open),
teacher_clean = clean_name(teacher)
)
# ==================================================
# CLEAN V2
# ==================================================
d_clean1 <- d1 %>%
mutate(
municipality = collapse_cols(cur_data(), municipality_cols),
school       = clean_text(`Unidade escolar:`),
teacher_list = clean_text(`Professor:`),
teacher_open = clean_text(.data[[teacher_open_col]])  # Use the defined column
)
teacher_matches <- pmap_dfr(
d_clean1 %>% select(teacher_open, teacher_list),
function(teacher_open, teacher_list) {
best_teacher_match(teacher_open, teacher_list)
}
)
d_clean1 <- bind_cols(d_clean1, teacher_matches) %>%
mutate(
teacher = coalesce(teacher_fuzzy_match, teacher_list, teacher_open),
teacher_clean = clean_name(teacher)
)
# ==================================================
# CLEAN V3
# ==================================================
d_clean2 <- d2 %>%
mutate(
municipality = collapse_cols(cur_data(), municipality_cols),
school       = clean_text(`Unidade escolar:`),
teacher_list = clean_text(`Professor:`),
teacher_open = clean_text(.data[[teacher_open_col]])
)
teacher_matches <- pmap_dfr(
d_clean2 %>% select(teacher_open, teacher_list),
function(teacher_open, teacher_list) {
best_teacher_match(teacher_open, teacher_list)
}
)
d_clean2 <- bind_cols(d_clean2, teacher_matches) %>%
mutate(
teacher = coalesce(
teacher_fuzzy_match,
teacher_list,
teacher_open
),
teacher_clean = clean_name(teacher)
)
# ==================================================
# CLEAN V3
# ==================================================
d_clean3 <- d3 %>%
mutate(
municipality = collapse_cols(cur_data(), municipality_cols),
school       = clean_text(`Unidade escolar:`),
teacher_list = clean_text(`Professor:`),
teacher_open = clean_text(.data[[teacher_open_col]])
)
teacher_matches <- pmap_dfr(
d_clean3 %>% select(teacher_open, teacher_list),
function(teacher_open, teacher_list) {
best_teacher_match(teacher_open, teacher_list)
}
)
d_clean3 <- bind_cols(d_clean3, teacher_matches) %>%
mutate(
teacher = coalesce(
teacher_fuzzy_match,
teacher_list,
teacher_open
),
teacher_clean = clean_name(teacher)
)
# ==================================================
# BIND
# ==================================================
common_vars <- Reduce(
intersect,
list(
names(d_clean),
names(d_clean1),
names(d_clean2),
names(d_clean3)
)
)
d_clean_final_g2 <- bind_rows(
d_clean  %>% select(all_of(common_vars)),
d_clean1 %>% select(all_of(common_vars)),
d_clean2 %>% select(all_of(common_vars)),
d_clean3 %>% select(all_of(common_vars))
)
# ==================================================
# STUDENTS (SOURCE OF TRUTH)
# ==================================================
students_by_teacher_g2 <- d_clean_final_g2 %>%
mutate(
student_name = clean_text(`Nome do Aluno:`),
student_name_clean = clean_name(`Nome do Aluno:`),
Completou = if_else(
!is.na(Fim),
"Sim",
"Não"
)
) %>%
filter(!is.na(teacher_clean), !is.na(student_name)) %>%
arrange(desc(Completou)) %>%
distinct(teacher_clean, student_name_clean, .keep_all = TRUE) %>%
left_join(teachers_clean, by = "teacher_clean")
d_clean_final_g2 <- d_clean_final_g2 %>%
mutate(
teacher_clean = case_when(
municipality == "Jiquirica" ~ "ALICE ALMEIDA BARRETO SANTOS",
`Nome do Aluno:`== "maria eduarda dos santos bastos" ~ " SUELEIDE ALVES DE SOUZA LIMA",
`Nome do Aluno:`== "Chintya soares ferreira" ~ "SUELEIDE ALVES DE SOUZA LIMA",
`Nome do Aluno:`== "Ana Luiza Dos Santos" ~ " SUELEIDE ALVES DE SOUZA LIMA",
`Nome do Aluno:`== "Rebeca De Santana Pinheiro" ~ " SUELEIDE ALVES DE SOUZA LIMA",
TRUE ~ teacher_clean
)
)
# ==================================================
# IMPUTAÇÃO CORRETA - GRUPO 2
# Usa SOMENTE questionários completos do Grupo 2
# para imputar os incompletos do Grupo 2
# Inclui NAs na distribuição
# ==================================================
set.seed(123)
# --------------------------------------------------
# 1) BASE PRINCIPAL G2
# --------------------------------------------------
base_g2 <- d_clean_final_g2 %>%
mutate(
student_name = clean_text(`Nome do Aluno:`),
student_name_clean = clean_name(`Nome do Aluno:`),
Completou = if_else(
!is.na(Fim),
"Sim",
"Não"
)
) %>%
filter(
!is.na(teacher_clean),
!is.na(student_name)
) %>%
arrange(desc(Completou)) %>%
distinct(
teacher_clean,
student_name_clean,
.keep_all = TRUE
) %>%
left_join(
teachers_clean,
by = "teacher_clean"
)
# --------------------------------------------------
# 2) SEPARAR COMPLETOS E INCOMPLETOS
# --------------------------------------------------
completed_g2 <- base_g2 %>%
filter(Completou == "Sim")
incomplete_g2 <- base_g2 %>%
filter(Completou == "Não")
# --------------------------------------------------
# 3) COLUNAS PARA IMPUTAR
# --------------------------------------------------
gender_col <- "d2"
cols_to_impute_g2 <- names(base_g2)[23:297]
cols_to_impute_g2 <- setdiff(
cols_to_impute_g2,
gender_col
)
cols_to_impute_g2 <- cols_to_impute_g2[
cols_to_impute_g2 %in% names(base_g2)
]
# --------------------------------------------------
# 4) HELPERS
# --------------------------------------------------
blank_to_na <- function(x) {
x %>%
as.character() %>%
str_squish() %>%
na_if("") %>%
na_if("NA")
}
draw_from_pool <- function(n, pool) {
if (length(pool) == 0) {
return(rep(NA_character_, n))
}
sample(
pool,
size = n,
replace = TRUE
)
}
# --------------------------------------------------
# 5) LIMPAR BLANKS
# --------------------------------------------------
completed_g2 <- completed_g2 %>%
mutate(
across(
all_of(cols_to_impute_g2),
blank_to_na
),
across(
all_of(gender_col),
blank_to_na
)
)
incomplete_g2_imputed <- incomplete_g2 %>%
mutate(
across(
all_of(cols_to_impute_g2),
blank_to_na
),
across(
all_of(gender_col),
blank_to_na
)
)
# --------------------------------------------------
# 6) IMPUTAÇÃO G2
# --------------------------------------------------
for (col in cols_to_impute_g2) {
cat("Imputando G2:", col, "\n")
global_pool <- completed_g2[[col]]
incomplete_g2_imputed <- incomplete_g2_imputed %>%
group_by(teacher_clean) %>%
group_modify(function(.x, .y) {
teacher_id <- .y$teacher_clean[[1]]
teacher_pool <- completed_g2 %>%
filter(teacher_clean == teacher_id) %>%
pull(!!sym(col))
pool <- if (length(teacher_pool) > 0) {
teacher_pool
} else {
global_pool
}
miss_idx <- is.na(.x[[col]])
if (sum(miss_idx) > 0) {
.x[[col]][miss_idx] <- draw_from_pool(
n = sum(miss_idx),
pool = pool
)
}
.x
}) %>%
ungroup()
}
# --------------------------------------------------
# 7) PADRONIZAR TIPOS
# --------------------------------------------------
completed_g2 <- completed_g2 %>%
mutate(across(everything(), as.character))
incomplete_g2_imputed <- incomplete_g2_imputed %>%
mutate(across(everything(), as.character))
# --------------------------------------------------
# 8) JUNTAR COMPLETOS + IMPUTADOS
# --------------------------------------------------
final_g2_with_imputed_incomplete <- bind_rows(
completed_g2,
incomplete_g2_imputed
)
# --------------------------------------------------
# 9) STUDENTS BY TEACHER G2
# --------------------------------------------------
students_by_teacher_g2 <- final_g2_with_imputed_incomplete %>%
mutate(
student_name = clean_text(`Nome do Aluno:`),
student_name_clean = clean_name(`Nome do Aluno:`),
Inputed = if_else(
Completou == "Não",
"Sim",
"Não"
)
) %>%
filter(
!is.na(teacher_clean),
!is.na(student_name)
) %>%
distinct(
teacher_clean,
student_name_clean,
.keep_all = TRUE
)
# --------------------------------------------------
# PADRONIZAR TIPOS ANTES DO BIND_ROWS
# --------------------------------------------------
final_g1_with_imputed_incomplete <- final_g1_with_imputed_incomplete %>%
mutate(across(everything(), as.character))
final_g2_with_imputed_incomplete <- final_g2_with_imputed_incomplete %>%
mutate(across(everything(), as.character))
# voltar variáveis numéricas importantes
if ("d1" %in% names(final_g1_with_imputed_incomplete)) {
final_g1_with_imputed_incomplete$d1 <- as.numeric(
final_g1_with_imputed_incomplete$d1
)
final_g2_with_imputed_incomplete$d1 <- as.numeric(
final_g2_with_imputed_incomplete$d1
)
}
# --------------------------------------------------
# JUNTAR BASES
# --------------------------------------------------
df_final <- bind_rows(
final_g1_with_imputed_incomplete,
final_g2_with_imputed_incomplete
)%>%distinct()%>%
mutate(treatment=ifelse(grupo=="Grupo 1",1,0))
